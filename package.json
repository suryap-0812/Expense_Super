{
  "name": "expense-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ml:test": "PYTHONPATH=. .venv/bin/pytest ml/tests",
    "ml:generate": "PYTHONPATH=. .venv/bin/python -m ml.src.generation.generator",
    "ml:validate": "PYTHONPATH=. .venv/bin/python -m ml.src.validation.dataset_validator",
    "ml:features": "PYTHONPATH=. .venv/bin/python -m ml.src.features.pipeline",
    "ml:train:anomaly": "PYTHONPATH=. .venv/bin/python -m ml.src.models.train_anomaly",
    "ml:train:clustering": "PYTHONPATH=. .venv/bin/python -m ml.src.models.clustering",
    "ml:validate:scenarios": "PYTHONPATH=. .venv/bin/python -m ml.src.validation.ml_scenario_validator",
    "ml:export:onnx": "PYTHONPATH=. .venv/bin/python -m ml.src.export.onnx_exporter",
    "ml:validate:onnx": "PYTHONPATH=. .venv/bin/python -m ml.src.validation.onnx_runtime_validator",
    "web:dev": "pnpm --filter @expense-tracker/web run dev",
    "web:build": "pnpm --filter @expense-tracker/web run build",
    "desktop:dev": "pnpm --filter @expense-tracker/desktop run dev",
    "desktop:build": "pnpm --filter @expense-tracker/desktop run build",
    "mobile:start": "pnpm --filter @expense-tracker/mobile run start",
    "mobile:typecheck": "pnpm --filter @expense-tracker/mobile run typecheck",
    "build:all": "bash scripts/build-all.sh",
    "package:release": "bash scripts/package-release.sh",
    "benchmark": "bash scripts/benchmark.sh",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run ml:test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^18.19.64",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
